# ==============================================================================
# HINOV Team Report (HTR) - Modèle de configuration (.env.example)
# ==============================================================================

# Port et environnement
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# Configuration Supabase (Base de données et Authentification)
# ------------------------------------------------------------------------------
# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co ou local http://127.0.0.1:54321)
SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique anonyme Supabase (anon key)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Chaîne de connexion PostgreSQL directe pour Drizzle ORM
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Sécurité & Chiffrement
# ------------------------------------------------------------------------------
# Clé secrète servant au chiffrement symétrique AES-256 des clés API Gemini utilisateurs
SESSION_SECRET=hinov-team-report-super-secret-key-change-in-production-32chars

# ------------------------------------------------------------------------------
# Frontend Expo (React Native)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_DOMAIN=localhost:8081

# ------------------------------------------------------------------------------
# Mockup Sandbox (Vite)
# ------------------------------------------------------------------------------
BASE_PATH=/

