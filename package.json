{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/hinov-team-report dev",
    "dev:clean": "pnpm --filter @workspace/hinov-team-report dev -- -c",
    "dev:app": "pnpm --filter @workspace/hinov-team-report dev",
    "dev:api": "pnpm --filter @workspace/api-server dev",
    "dev:mockup": "pnpm --filter @workspace/mockup-sandbox dev",
    "start": "pnpm --filter @workspace/hinov-team-report start",
    "start:clean": "pnpm --filter @workspace/hinov-team-report start -c",
    "web": "pnpm --filter @workspace/hinov-team-report web",
    "web:clean": "pnpm --filter @workspace/hinov-team-report web -- -c",
    "android": "pnpm --filter @workspace/hinov-team-report android",
    "ios": "pnpm --filter @workspace/hinov-team-report ios",
    "tunnel": "pnpm --filter @workspace/hinov-team-report start --tunnel",
    "tunnel:clean": "pnpm --filter @workspace/hinov-team-report start --tunnel -c",
    "create-admin": "pnpm --filter @workspace/scripts create-admin",
    "build:apk": "cd artifacts/hinov-team-report && npx eas-cli build -p android --profile preview",
    "build:ios": "cd artifacts/hinov-team-report && npx eas-cli build -p ios --profile preview",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "expo": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
