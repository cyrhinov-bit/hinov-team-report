{
  "name": "hinov-team-report",
  "version": "1.0.0",
  "description": "Hinov Team Report (HTR) - Application Desktop & Mobile de Reporting Hebdomadaire",
  "author": "HINOV GROUP <contact@hinovgroup.com>",
  "homepage": "https://hinovgroup.com",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && concurrently -k -s first \"cross-env CI=1 npx expo start --web --port 8081\" \"wait-on http://127.0.0.1:8081 && cross-env NODE_ENV=development electron electron/dist/main.js\"",
    "electron:build:web": "npx expo export -p web",
    "electron:build:exe": "npm run electron:compile && npm run electron:build:web && electron-builder --win",
    "electron:dist": "npm run electron:compile && npm run electron:build:web && electron-builder"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^0.439.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3",
    "wait-on": "^9.1.0"
  },
  "private": true
}
